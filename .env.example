# SteamBazari Environment Configuration

# Database
# Default is SQLite for instant zero-dependency local execution
DATABASE_URL="file:./dev.db"
# Or PostgreSQL for production:
# DATABASE_URL="postgresql://user:password@localhost:5432/steambazari?schema=public"

# App & Security
NEXTAUTH_SECRET="your-32-character-random-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Secret Encryption Key (Must be 32 bytes hex or 32 chars for AES-256-GCM account credential encryption)
ENCRYPTION_SECRET_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Google OAuth 2.0 (Official Gmail Integration for Verification Codes)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/admin/email-integration/callback"

# Admin Initial Setup (Optional initial seed config)
ADMIN_DEFAULT_EMAIL="admin@steambazari.az"
ADMIN_DEFAULT_PASSWORD="AdminSecurePassword2026!"

// SteamBazari Guard & Verification Portal Schema
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String         // Ad və Soyad (Müştərinin adı)
  email         String?        @unique
  passwordHash  String
  plainPassword String?        // Admin panelində görünməsi üçün
  role          String         @default("CUSTOMER") // "CUSTOMER" | "ADMIN"
  phone         String?
  unlockedGames String[]       @default([]) // "GTA5", "RDR2"
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  requests      GuardRequest[]
  redeemedCodes RedeemCode[]   @relation("UserRedeems")

  @@index([name])
  @@index([email])
  @@index([role])
}

model RedeemCode {
  id           String    @id @default(uuid())
  code         String    @unique // Məs: "EI-GTA5-7F2A" və ya "NQ-RDR2-9K4B"
  game         String    // "GTA5" | "RDR2"
  customerName String?   // Müştərinin adı
  initials     String?   // Müştərinin adının baş hərfləri (Məs: "EI", "NQ")
  isUsed       Boolean   @default(false)
  usedByUserId String?
  usedByName   String?
  usedAt       DateTime?
  createdBy    String?   @default("ADMIN")
  createdAt    DateTime  @default(now())

  usedByUser   User?     @relation("UserRedeems", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([game])
  @@index([isUsed])
  @@index([usedByUserId])
}

model GuardRequest {
  id           String    @id @default(uuid())
  userId       String
  game         String    // "GTA5" | "RDR2"
  targetEmail  String    // "isayevelcan5@gmail.com" | "steambazari.rdr2@gmail.com"
  code         String?
  subject      String?
  sender       String?
  status       String    @default("SUCCESS") // "SUCCESS" | "FAILED" | "PENDING"
  errorMessage String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([game])
  @@index([userId])
  @@index([createdAt])
}

model GmailConfig {
  id                String    @id @default(uuid())
  game              String    @unique // "GTA5" | "RDR2"
  gameName          String    // "Grand Theft Auto V" | "Red Dead Redemption 2"
  email             String
  encryptedPassword String?   // App Password or regular password encrypted
  authType          String    @default("APP_PASSWORD") // "APP_PASSWORD" | "OAUTH2"
  status            String    @default("NEEDS_CONFIG") // "CONNECTED" | "NEEDS_CONFIG" | "ERROR"
  lastCheckedAt     DateTime?
  lastCodeFound     String?
  lastSubjectFound  String?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String   // "CODE_REQUEST", "CONFIG_UPDATE", "LOGIN", "REGISTER", "REDEEM_CODE"
  userId     String?
  userEmail  String?
  game       String?
  ipAddress  String?
  details    String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
